{
  "name": "Poll",
  "version": "0.0.1",
  "description": "Make decisions with friends via ranked voting/poll!",
  "main": "index.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "docker:compose": "docker-compose up -d redis",
    "client:dev": "npm run dev --workspace=client",
    "server:dev": "wait-on tcp:6380 && npm run start:dev --workspace=server",
    "server:dev:docker": "wait-on tcp:redis:6379 && npm run start:dev --workspace=server",
    "start": "concurrently 'npm:docker:compose' 'npm:server:dev' 'npm:client:dev'",
    "storybook": "npm run storybook --workspace=client",
    "stop": "docker-compose down",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ts",
    "react",
    "nestjs",
    "socketjs"
  ],
  "author": "Raymond Mao",
  "license": "MIT",
  "devDependencies": {
    "@types/webpack": "^5.28.0",
    "concurrently": "^7.0.0",
    "prettier": "^2.5.1",
    "typescript": "4.9.5",
    "wait-on": "^6.0.1"
  }
}
